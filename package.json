{
  "name": "elhazem",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @elhazem/web",
    "dev:admin": "npm run dev -w @elhazem/admin",
    "dev:analytics": "npm run dev -w @elhazem/analytics",
    "dev:mobile": "npm run start -w @elhazem/mobile",
    "build:web": "npm run build -w @elhazem/web",
    "build:admin": "npm run build -w @elhazem/admin",
    "build:analytics": "npm run build -w @elhazem/analytics",
    "build": "npm run build -w @elhazem/web && npm run build -w @elhazem/admin && npm run build -w @elhazem/analytics"
  }
}
