# دي Secrets بتتحط على مستوى مشروع Supabase (مش ملف .env عادي) عن طريق:
#   supabase secrets set --env-file supabase/functions/.env
# (انسخ الملف ده لـ supabase/functions/.env وحط القيم الحقيقية، الملف ده متجاهل في git).
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY بيتحقنوا تلقائيًا من Supabase —
# متحطهمش هنا.

# Paymob dashboard → Settings → Account Info
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
# Paymob dashboard → Developers → Payment Integrations (تكامل الكارت وتكامل المحفظة رقمين مختلفين)
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
# Paymob dashboard → Developers → Webhooks → HMAC Secret
PAYMOB_HMAC_SECRET=

# رابط الـ webhook function بعد النشر، مثال:
# https://<project-ref>.functions.supabase.co/paymob-webhook
PAYMOB_WEBHOOK_URL=
# رابط صفحة "اكتملت العملية" في موقعك، مثال:
# https://alhazempharmacy2026-hue.github.io/elhazem/checkout/complete
PAYMOB_REDIRECT_URL=
