<div class="section">
  <div class="container page-narrow text-center" style="padding-block:4rem">
    {%- if settings.logo -%}
      <img
        src="{{ settings.logo | image_url: width: 400 }}"
        alt="{{ shop.name | escape }}"
        width="{{ settings.logo.width }}"
        height="{{ settings.logo.height }}"
        style="width:180px;height:auto;margin:0 auto 1.5rem"
      >
    {%- else -%}
      <h1>{{ shop.name }}</h1>
    {%- endif -%}

    <p class="section-head__sub">{{ shop.password_message | default: 'هنفتح قريب جدًا — سيبي إيميلك ونبعتلك أول ما نفتح.' }}</p>

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
      <div style="display:flex;gap:.5rem;max-width:420px;margin:1.5rem auto 0">
        <label class="visually-hidden" for="password-email">{{ 'general.newsletter.email' | t }}</label>
        <input id="password-email" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required>
        <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
      </div>
    {%- endform -%}

    <div class="auth-card" style="margin-top:2.5rem">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="store-password">{{ 'customer.login.password' | t }}</label>
          <input id="store-password" type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn--full">{{ 'customer.login.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
