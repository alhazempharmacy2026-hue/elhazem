<div class="section">
  <div class="container">
    <div class="auth-card">
      <h1>{{ 'customer.recover.title' | t }}</h1>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="reset-password">{{ 'customer.login.password' | t }}</label>
          <input id="reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="reset-password-confirm">{{ 'customer.login.password' | t }}</label>
          <input id="reset-password-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--full">{{ 'customer.recover.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>
