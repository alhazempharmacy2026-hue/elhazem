<div class="section">
  <div class="container">
    <div class="auth-card">
      <h1>{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label for="register-first">{{ 'customer.register.first_name' | t }}</label>
          <input id="register-first" type="text" name="customer[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="register-last">{{ 'customer.register.last_name' | t }}</label>
          <input id="register-last" type="text" name="customer[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label for="register-email">{{ 'customer.login.email' | t }}</label>
          <input id="register-email" type="email" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="register-password">{{ 'customer.login.password' | t }}</label>
          <input id="register-password" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
      <p style="text-align:center;margin-top:1rem">
        {{ 'customer.register.has_account' | t }}
        <a class="link-underline" href="{{ routes.account_login_url }}">{{ 'customer.login.submit' | t }}</a>
      </p>
    </div>
  </div>
</div>
