{%- paginate blog.articles by 9 -%}
  <div class="section">
    <div class="container">
      <h1>{{ blog.title }}</h1>
      {%- if blog.articles.size > 0 -%}
        <div class="article-grid">
          {%- for article in blog.articles -%}
            <article>
              <a class="article-card__media" href="{{ article.url }}">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 750px) 30vw, 92vw"
                    alt="{{ article.image.alt | escape }}"
                    width="800"
                    height="500"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </a>
              <div class="article-card__meta">{{ article.published_at | date: '%d/%m/%Y' }}</div>
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="section-head__sub">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              <a class="section-head__link" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }} →</a>
            </article>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{ "name": "المدونة", "settings": [] }
{% endschema %}
