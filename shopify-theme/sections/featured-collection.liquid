{%- assign collection = collections[section.settings.collection] -%}
{%- if collection.products.size > 0 -%}
  <div class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{{ section.settings.heading | default: collection.title }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="section-head__sub">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        <a class="section-head__link" href="{{ collection.url }}">{{ 'collections.general.view_all' | t }} →</a>
      </div>

      <div class="product-grid" style="--grid-md: {{ section.settings.columns | minus: 1 }}; --grid-lg: {{ section.settings.columns }}">
        {%- for product in collection.products limit: section.settings.limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section">
    <div class="container">
      <p class="form-status form-status--error">
        اختاري مجموعة لقسم "{{ section.settings.heading }}" — القسم ده مش بيظهر للزبائن طالما فاضي.
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "مجموعة منتجات",
  "settings": [
    { "type": "collection", "id": "collection", "label": "المجموعة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "الأكثر مبيعًا" },
    { "type": "text", "id": "subheading", "label": "العنوان الفرعي" },
    { "type": "range", "id": "limit", "min": 4, "max": 16, "step": 2, "label": "عدد المنتجات", "default": 8 },
    { "type": "range", "id": "columns", "min": 3, "max": 5, "step": 1, "label": "عدد الأعمدة (كمبيوتر)", "default": 4 },
    { "type": "checkbox", "id": "soft_bg", "label": "خلفية ثانوية", "default": false }
  ],
  "presets": [{ "name": "مجموعة منتجات" }]
}
{% endschema %}
