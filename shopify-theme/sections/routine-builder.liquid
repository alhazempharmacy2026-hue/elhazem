{%- comment -%}
  A full skin/hair routine sold as one click. Each block is a step; the footer
  totals the steps and adds them all to the cart in a single request.
{%- endcomment -%}

{%- liquid
  assign total = 0
  assign compare_total = 0
  assign available_steps = 0
  for block in section.blocks
    assign step_product = block.settings.product
    if step_product != blank
      assign step_variant = step_product.selected_or_first_available_variant
      if step_variant.available
        assign total = total | plus: step_variant.price
        assign available_steps = available_steps | plus: 1
        if step_variant.compare_at_price > step_variant.price
          assign compare_total = compare_total | plus: step_variant.compare_at_price
        else
          assign compare_total = compare_total | plus: step_variant.price
        endif
      endif
    endif
  endfor
  assign saved = compare_total | minus: total
-%}

<div class="section {% if section.settings.soft_bg %}section--soft{% endif %}">
  <div class="container">
    <div class="section-head">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="section-head__link" href="{{ section.settings.link }}">{{ section.settings.link_label }} ←</a>
      {%- endif -%}
    </div>

    <bundle-add>
      <div class="routine" style="--routine-cols: {{ section.blocks.size | at_most: 5 }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign step_product = block.settings.product
            assign step_variant = step_product.selected_or_first_available_variant
            assign step_label = block.settings.step_label
            if step_label == blank
              assign step_label = 'sections.routine.step' | t: number: forloop.index
            endif
          -%}
          <div class="routine__step" {{ block.shopify_attributes }}>
            <div class="routine__head">
              <span class="routine__num">{{ forloop.index }}</span>
              <span class="routine__label">{{ step_label }}</span>
            </div>

            {%- if step_product != blank -%}
              <a class="routine__media" href="{{ step_product.url }}" tabindex="-1" aria-hidden="true">
                {%- if step_product.featured_media -%}
                  <img
                    src="{{ step_product.featured_media | image_url: width: 400 }}"
                    srcset="{{ step_product.featured_media | image_url: width: 200 }} 200w, {{ step_product.featured_media | image_url: width: 400 }} 400w"
                    sizes="(min-width: 750px) 18vw, 88vw"
                    alt="{{ step_product.featured_media.alt | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </a>

              <a class="routine__title" href="{{ step_product.url }}">{{ step_product.title | escape }}</a>

              {%- if block.settings.note != blank -%}
                <p class="routine__note">{{ block.settings.note }}</p>
              {%- endif -%}

              {%- render 'price', variant: step_variant -%}

              {%- if step_variant.available -%}
                <input
                  type="hidden"
                  data-bundle-item
                  value="{{ step_variant.id }}"
                  data-price="{{ step_variant.price }}"
                  data-compare="{{ step_variant.compare_at_price | default: step_variant.price }}"
                >
              {%- else -%}
                <span class="stock stock--out">{{ 'products.product.sold_out' | t }}</span>
              {%- endif -%}
            {%- else -%}
              <div class="routine__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
              <span class="routine__title">{{ 'products.product.choose_options' | t }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if available_steps > 0 -%}
        <div class="routine__foot">
          <div class="routine__totals">
            <span class="routine__total-label">{{ 'sections.routine.total' | t }}</span>
            <span class="routine__total" data-bundle-total>{{ total | money }}</span>
            {%- if saved > 0 -%}
              <s class="price__compare" data-bundle-compare>{{ compare_total | money }}</s>
              {%- assign saved_money = saved | money -%}
              <span class="price__save" data-bundle-save>
                {{- 'products.product.save_amount' | t: amount: saved_money -}}
              </span>
            {%- else -%}
              <s class="price__compare" data-bundle-compare hidden></s>
              <span class="price__save" data-bundle-save hidden></span>
            {%- endif -%}
          </div>
          <button type="button" class="btn btn--lg" data-bundle-submit>
            {{ 'sections.routine.add_full' | t }}
          </button>
        </div>
      {%- endif -%}
    </bundle-add>
  </div>
</div>

{% schema %}
{
  "name": "روتين كامل",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "روتين البشرة الدهنية" },
    {
      "type": "text",
      "id": "subheading",
      "label": "العنوان الفرعي",
      "default": "خمس خطوات بالترتيب — أضيفيها كلها بضغطة واحدة"
    },
    { "type": "text", "id": "link_label", "label": "نص رابط جانبي" },
    { "type": "url", "id": "link", "label": "الرابط" },
    { "type": "checkbox", "id": "soft_bg", "label": "خلفية ثانوية", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "خطوة",
      "settings": [
        { "type": "product", "id": "product", "label": "المنتج" },
        {
          "type": "text",
          "id": "step_label",
          "label": "اسم الخطوة",
          "info": "زي: التنظيف، التونر، السيروم، الترطيب، واقي الشمس"
        },
        { "type": "text", "id": "note", "label": "ملاحظة قصيرة", "info": "زي: صباحًا ومساءً" }
      ]
    }
  ],
  "presets": [
    {
      "name": "روتين كامل",
      "blocks": [
        { "type": "step", "settings": { "step_label": "التنظيف" } },
        { "type": "step", "settings": { "step_label": "التونر" } },
        { "type": "step", "settings": { "step_label": "السيروم" } },
        { "type": "step", "settings": { "step_label": "الترطيب" } },
        { "type": "step", "settings": { "step_label": "واقي الشمس" } }
      ]
    }
  ]
}
{% endschema %}
