<div class="section">
  <div class="container">
    <h1>{{ 'cart.general.title' | t }}</h1>

    <div data-cart-section-id="main-cart">
      {%- if cart.item_count == 0 -%}
        <div class="empty-state">
          {%- render 'icon', name: 'bag-empty' -%}
          <h2>{{ 'cart.general.empty' | t }}</h2>
          <p class="cart-note">{{ 'cart.general.empty_note' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">
            {{ 'cart.general.continue_shopping' | t }}
          </a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" novalidate class="cart-grid">
          <div>
            {%- render 'free-shipping-bar' -%}
            <cart-items>
              {%- for item in cart.items -%}
                {%- render 'cart-line-item', item: item, line: forloop.index -%}
              {%- endfor -%}
            </cart-items>

            {%- if section.settings.show_note -%}
              <div class="field" style="margin-top:1.25rem">
                <label for="cart-note">{{ 'cart.general.note' | t }}</label>
                <textarea
                  id="cart-note"
                  name="note"
                  placeholder="{{ 'cart.general.note_placeholder' | t }}"
                >{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
          </div>

          <aside class="cart-summary">
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-summary__row">
                <span>{{ discount.title }}</span>
                <span>−{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}

            <div class="cart-summary__row cart-summary__row--total">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <p class="cart-note">{{ 'cart.general.shipping_note' | t }}</p>
            {%- if settings.show_cod_note -%}
              <p class="cart-note">💵 {{ 'cart.general.cod_note' | t }}</p>
            {%- endif -%}

            <button type="submit" name="checkout" class="btn btn--full btn--lg" style="margin-top:.75rem">
              {{ 'cart.general.checkout' | t }}
            </button>
            <a class="btn btn--outline btn--full" style="margin-top:.5rem" href="{{ routes.all_products_collection_url }}">
              {{ 'cart.general.continue_shopping' | t }}
            </a>
          </aside>
        </form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "صفحة العربة",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "إظهار ملاحظات الطلب", "default": true }
  ]
}
{% endschema %}
