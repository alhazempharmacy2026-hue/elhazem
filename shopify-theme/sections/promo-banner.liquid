<div class="section">
  <div class="container">
    <div class="promo {% if section.settings.reverse %}promo--reverse{% endif %}">
      <div class="promo__media">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="1200"
            height="900"
            loading="lazy"
          >
        {%- else -%}
          {%- comment -%}
            Shopify's grey placeholder reads as a broken image on a live store.
            Until a real photo is uploaded, draw a branded panel instead.
          {%- endcomment -%}
          <svg
            class="promo__art"
            viewBox="0 0 800 600"
            role="img"
            aria-label="{{ section.settings.heading | escape }}"
            preserveAspectRatio="xMidYMid slice"
          >
            <defs>
              <linearGradient id="promo-sky-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--color-brand)"/>
                <stop offset="1" stop-color="var(--color-text)"/>
              </linearGradient>
            </defs>
            <rect width="800" height="600" fill="url(#promo-sky-{{ section.id }})"/>
            <circle cx="120" cy="90" r="190" fill="#ffffff" opacity=".07"/>
            <circle cx="700" cy="520" r="150" fill="#ffffff" opacity=".06"/>
            <g transform="rotate(-26 190 430)">
              <rect x="60" y="392" width="300" height="104" rx="52" fill="#ffffff" opacity=".16"/>
            </g>
            <g transform="rotate(-26 640 130)">
              <rect x="556" y="96" width="200" height="70" rx="35" fill="#ffffff" opacity=".12"/>
            </g>
            <circle cx="612" cy="452" r="26" fill="var(--color-accent)"/>
            <g transform="translate(400 300)" fill="none" stroke="#ffffff" stroke-width="13"
               stroke-linecap="round" stroke-linejoin="round" opacity=".92">
              <path d="M0-118 106-72v92c0 68-46 121-106 138-60-17-106-70-106-138v-92z"/>
              <path d="M-46 6 -12 40 50-22"/>
            </g>
          </svg>
        {%- endif -%}
      </div>
      <div class="promo__body">
        {%- if section.settings.kicker != blank -%}
          <span class="hero__kicker" style="color:var(--color-brand)">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "بانر ترويجي",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "الصورة" },
    { "type": "text", "id": "kicker", "label": "نص علوي صغير", "default": "ليه من الحازم؟" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "صيدلية… مش صفحة بتبيع" },
    {
      "type": "richtext",
      "id": "text",
      "label": "النص",
      "default": "<p>كل منتج بييجي من موزّع موثوق ويتخزّن بالطريقة اللي الشركة المصنّعة بتحددها — ده الفرق بين صيدلية وبين حد بيبيع من البيت.</p><p>ولو محتارة تختاري إيه لبشرتك، اسألي الصيدلي على واتساب قبل ما تشتري.</p>"
    },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "كلّمي الصيدلي" },
    { "type": "url", "id": "button_link", "label": "رابط الزر" },
    { "type": "checkbox", "id": "reverse", "label": "عكس ترتيب الصورة والنص", "default": false }
  ],
  "presets": [{ "name": "بانر ترويجي" }]
}
{% endschema %}
