<div class="section">
  <div class="container">
    <div class="promo {% if section.settings.reverse %}promo--reverse{% endif %}">
      <div class="promo__media">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="1200"
            height="900"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      <div class="promo__body">
        {%- if section.settings.kicker != blank -%}
          <span class="hero__kicker" style="color:var(--color-brand)">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "بانر ترويجي",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "الصورة" },
    { "type": "text", "id": "kicker", "label": "نص علوي صغير" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "روتين عناية كامل بأقل سعر" },
    {
      "type": "richtext",
      "id": "text",
      "label": "النص",
      "default": "<p>اختاري باقة العناية المناسبة لنوع بشرتك ووفري لحد ٣٠٪ على الباقة.</p>"
    },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "شوفي الباقات" },
    { "type": "url", "id": "button_link", "label": "رابط الزر" },
    { "type": "checkbox", "id": "reverse", "label": "عكس ترتيب الصورة والنص", "default": false }
  ],
  "presets": [{ "name": "بانر ترويجي" }]
}
{% endschema %}
