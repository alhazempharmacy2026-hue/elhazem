<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__heading">
          {%- if settings.logo -%}
            <img
              src="{{ settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name | escape }}"
              width="{{ settings.logo.width }}"
              height="{{ settings.logo.height }}"
              style="width:150px;height:auto"
              loading="lazy"
            >
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </div>
        {%- if section.settings.about != blank -%}
          <div class="footer__about rte">{{ section.settings.about }}</div>
        {%- endif -%}

        {%- if settings.phone != blank -%}
          <p class="footer__about" style="margin-top:.6rem">
            {%- render 'icon', name: 'phone' -%} <a href="tel:{{ settings.phone | remove: ' ' }}">{{ settings.phone }}</a>
          </p>
        {%- endif -%}

        <div class="footer__social">
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.whatsapp_number != blank -%}
            <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading }}</div>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__heading">{{ block.settings.heading }}</div>
              <p class="footer__about">{{ block.settings.text }}</p>
              {%- form 'customer' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-status form-status--success">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
                <div class="field">
                  <label class="visually-hidden" for="footer-newsletter">{{ 'general.newsletter.email' | t }}</label>
                  <input
                    id="footer-newsletter"
                    type="email"
                    name="contact[email]"
                    placeholder="{{ 'general.newsletter.email' | t }}"
                    required
                  >
                </div>
                <button type="submit" class="btn btn--full btn--sm">{{ 'general.newsletter.submit' | t }}</button>
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_note }}</span>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "الفوتر",
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "نبذة عن المتجر",
      "default": "<p>منتجات تجميل وعناية أصلية ١٠٠٪ بأفضل الأسعار، وتوصيل لكل محافظات مصر.</p>"
    },
    {
      "type": "text",
      "id": "copyright_note",
      "label": "ملاحظة حقوق النشر",
      "default": "كل الحقوق محفوظة."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "إظهار أيقونات وسائل الدفع",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "قائمة روابط",
      "settings": [
        { "type": "text", "id": "heading", "label": "العنوان", "default": "روابط سريعة" },
        { "type": "link_list", "id": "menu", "label": "القائمة", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "النشرة البريدية",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "العنوان", "default": "اشتركي في النشرة" },
        {
          "type": "text",
          "id": "text",
          "label": "النص",
          "default": "خصومات وعروض حصرية قبل الكل."
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
