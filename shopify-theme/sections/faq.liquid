<div class="section">
  <div class="container" style="max-width:820px">
    <div class="section-head">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">{{ block.settings.question }}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "الأسئلة الشائعة",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "أسئلة شائعة" },
    { "type": "text", "id": "subheading", "label": "العنوان الفرعي" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "سؤال",
      "settings": [
        { "type": "text", "id": "question", "label": "السؤال", "default": "الشحن بياخد قد إيه؟" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "الإجابة",
          "default": "<p>القاهرة والجيزة من ١ إلى ٢ يوم عمل، وباقي المحافظات من ٢ إلى ٤ أيام عمل.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "الأسئلة الشائعة",
      "blocks": [{ "type": "faq" }, { "type": "faq" }, { "type": "faq" }]
    }
  ]
}
{% endschema %}
