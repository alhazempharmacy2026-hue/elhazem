<div class="section">
  <div class="container">
    <h1>{{ page_title }}</h1>
    <div class="tiles" style="--tiles-md:4">
      {%- for collection in collections -%}
        <a class="tile" href="{{ collection.url }}">
          {%- liquid
            assign image = collection.featured_image
            assign from_product = false
            if image == blank
              assign image = collection.products.first.featured_image
              assign from_product = true
            endif
          -%}
          <div class="tile__media {% if from_product %}tile__media--product{% endif %}">
            {%- if image -%}
              <img
                src="{{ image | image_url: width: 600 }}"
                srcset="{{ image | image_url: width: 300 }} 300w, {{ image | image_url: width: 600 }} 600w"
                sizes="(min-width: 750px) 22vw, 45vw"
                alt="{{ image.alt | escape }}"
                width="600"
                height="750"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <span class="tile__label">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "كل المجموعات", "settings": [] }
{% endschema %}
