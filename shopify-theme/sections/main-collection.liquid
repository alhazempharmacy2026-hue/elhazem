{%- paginate collection.products by section.settings.per_page -%}
  <div class="section">
    <div class="container">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
        <span>/</span>{{ collection.title }}
      </nav>

      <div class="section-head">
        <div>
          <h1>{{ collection.title }}</h1>
          {%- if collection.description != blank and section.settings.show_description -%}
            <div class="section-head__sub rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      </div>

      <div class="collection-layout">
        {%- if section.settings.show_filters and collection.filters.size > 0 -%}
          <aside class="facets">
            <facets-panel>
            <details class="facets__wrap">
              <summary class="facets__wrap-summary">{{ 'collections.general.filters' | t }}</summary>
            <form class="facets__form" method="get">
              {%- if collection.sort_by != blank -%}
                <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
              {%- endif -%}
              {%- for filter in collection.filters -%}
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    <details class="facets__group" open>
                      <summary>{{ filter.label }}</summary>
                      <ul class="facets__list">
                        {%- for value in filter.values -%}
                          <li>
                            <label>
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span>{{ value.label }}</span>
                              <span class="facets__count">({{ value.count }})</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- when 'price_range' -%}
                    <details class="facets__group" open>
                      <summary>{{ filter.label }}</summary>
                      <div style="display:flex;gap:.5rem;margin-top:.75rem">
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="0"
                          min="0"
                          aria-label="{{ 'collections.general.price_range' | t }}"
                        >
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          min="0"
                          aria-label="{{ 'collections.general.price_range' | t }}"
                        >
                      </div>
                    </details>
                {%- endcase -%}
              {%- endfor -%}

              <div style="display:flex;gap:.5rem;margin-top:1rem">
                <button type="submit" class="btn btn--sm">{{ 'collections.general.apply' | t }}</button>
                <a class="btn btn--sm btn--outline" href="{{ collection.url }}">{{ 'collections.general.clear_filters' | t }}</a>
              </div>
            </form>
            </details>
            </facets-panel>
          </aside>
        {%- else -%}
          <div></div>
        {%- endif -%}

        <div>
          <div class="collection-toolbar">
            <span class="collection-toolbar__count">
              {{ 'collections.general.products_count' | t: count: collection.products_count }}
            </span>
            {%- if section.settings.show_sort -%}
              <div class="collection-toolbar__sort">
                <label for="sort-by">{{ 'collections.general.sort_by' | t }}</label>
                <select id="sort-by" data-sort-by>
                  {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                      {{ option.name }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          </div>

          {%- if collection.products.size > 0 -%}
            <div class="product-grid" style="--grid-md: {{ section.settings.columns | minus: 1 }}; --grid-lg: {{ section.settings.columns }}">
              {%- for product in collection.products -%}
                {%- render 'product-card', product: product, lazy: forloop.first -%}
              {%- endfor -%}
            </div>
            {%- render 'pagination', paginate: paginate -%}
          {%- else -%}
            <div class="empty-state">
              <p>{{ 'collections.general.empty' | t }}</p>
              <a class="btn" href="{{ routes.all_products_collection_url }}">
                {{ 'collections.general.all_products' | t }}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "صفحة المجموعة",
  "settings": [
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "منتجات في الصفحة", "default": 24 },
    { "type": "range", "id": "columns", "min": 3, "max": 5, "step": 1, "label": "عدد الأعمدة (كمبيوتر)", "default": 4 },
    { "type": "checkbox", "id": "show_description", "label": "إظهار وصف المجموعة", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "إظهار الفلاتر", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "إظهار الترتيب", "default": true }
  ]
}
{% endschema %}
