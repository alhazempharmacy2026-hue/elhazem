{%- comment -%}
  Hero that shows the store's real products instead of a flat banner image,
  so it can never go stale. Copy sits on one side, live product cards on the
  other, over a brand-coloured ground drawn in CSS.
{%- endcomment -%}

{%- assign hero_collection = collections[section.settings.collection] -%}

{%- if hero_collection.products.size > 0 -%}
  <section class="phero">
    <div class="phero__ground" aria-hidden="true">
      <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" focusable="false">
        <defs>
          <linearGradient id="phero-sky-{{ section.id }}" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--color-brand)"/>
            <stop offset="1" stop-color="var(--color-text)"/>
          </linearGradient>
        </defs>
        <rect width="1200" height="600" fill="url(#phero-sky-{{ section.id }})"/>
        <circle cx="180" cy="90" r="260" fill="#ffffff" opacity=".07"/>
        <circle cx="1040" cy="520" r="200" fill="#ffffff" opacity=".05"/>
        <g transform="rotate(-28 250 470)" opacity=".16">
          <rect x="60" y="430" width="340" height="120" rx="60" fill="#ffffff"/>
        </g>
        <g transform="rotate(-28 980 110)" opacity=".12">
          <rect x="880" y="60" width="220" height="78" rx="39" fill="#ffffff"/>
        </g>
        <circle cx="742" cy="548" r="34" fill="var(--color-accent)"/>
      </svg>
    </div>

    <div class="container phero__inner">
      <div class="phero__copy">
        {%- if section.settings.kicker != blank -%}
          <span class="phero__kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}

        <h1 class="phero__title">{{ section.settings.heading }}</h1>

        {%- if section.settings.text != blank -%}
          <p class="phero__text">{{ section.settings.text }}</p>
        {%- endif -%}

        <div class="phero__cta">
          <a class="btn btn--lg" href="{{ section.settings.button_link | default: hero_collection.url }}">
            {{ section.settings.button_label }}
          </a>
          {%- if section.settings.show_whatsapp and settings.whatsapp_number != blank -%}
            <a
              class="btn btn--lg phero__wa"
              href="https://wa.me/{{ settings.whatsapp_number }}"
              target="_blank"
              rel="noopener"
            >
              {%- render 'icon', name: 'whatsapp' -%}
              {{ section.settings.whatsapp_label }}
            </a>
          {%- endif -%}
        </div>

        <ul class="phero__trust">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'icon', name: block.settings.icon -%}
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="phero__stack">
        {%- for product in hero_collection.products limit: section.settings.count -%}
          {%- assign hero_variant = product.selected_or_first_available_variant -%}
          <a class="phero__card" href="{{ product.url }}">
            <span class="phero__media">
              {%- if product.featured_media -%}
                <img
                  src="{{ product.featured_media | image_url: width: 500 }}"
                  srcset="{{ product.featured_media | image_url: width: 250 }} 250w, {{ product.featured_media | image_url: width: 500 }} 500w"
                  sizes="(min-width: 990px) 15vw, 40vw"
                  alt="{{ product.featured_media.alt | escape }}"
                  width="500"
                  height="500"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="phero__meta">
              {%- if product.vendor != blank -%}
                <span class="phero__vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <span class="phero__name">{{ product.title | split: ' — ' | last }}</span>
              <span class="phero__price">{{ hero_variant.price | money }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="section">
    <div class="container">
      <p class="form-status form-status--error">
        اختاري مجموعة للبانر الرئيسي — البانر مش بيظهر للزبائن طالما مفيش منتجات.
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "بانر بمنتجات حقيقية",
  "max_blocks": 4,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "المجموعة المعروضة",
      "info": "المنتجات بتتسحب من المتجر وقت العرض — يعني الصور والأسعار دايمًا محدّثة."
    },
    { "type": "range", "id": "count", "min": 2, "max": 4, "step": 1, "label": "عدد المنتجات", "default": 3 },
    { "type": "text", "id": "kicker", "label": "نص علوي صغير", "default": "من صيدلية الحازم" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "منتجات أصلية… من صيدلية حقيقية" },
    {
      "type": "text",
      "id": "text",
      "label": "النص",
      "default": "مش صفحة بتبيع — صيدلية معروفة بتوصّلك منتجات عناية أصلية ١٠٠٪ لكل محافظات مصر."
    },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "تسوقي دلوقتي" },
    { "type": "url", "id": "button_link", "label": "رابط الزر" },
    { "type": "checkbox", "id": "show_whatsapp", "label": "إظهار زر واتساب", "default": true },
    { "type": "text", "id": "whatsapp_label", "label": "نص زر واتساب", "default": "اسألي الصيدلي" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "نقطة ثقة",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "الأيقونة",
          "options": [
            { "value": "shield", "label": "أصلي" },
            { "value": "truck", "label": "شحن" },
            { "value": "cash", "label": "دفع عند الاستلام" },
            { "value": "return", "label": "استبدال" },
            { "value": "headset", "label": "دعم" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "text", "label": "النص", "default": "أصلي ١٠٠٪" }
      ]
    }
  ],
  "presets": [
    {
      "name": "بانر بمنتجات حقيقية",
      "blocks": [
        { "type": "point", "settings": { "icon": "shield", "text": "أصلي ١٠٠٪" } },
        { "type": "point", "settings": { "icon": "cash", "text": "الدفع عند الاستلام" } },
        { "type": "point", "settings": { "icon": "truck", "text": "شحن لكل مصر" } }
      ]
    }
  ]
}
{% endschema %}
