{%- comment -%}
  Renders a price block.
  Accepts: product (optional), variant (optional), show_savings (bool), class (string)
{%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare = variant.compare_at_price
    assign show_from = false
  elsif product
    assign target = product.selected_or_first_available_variant
    assign price = target.price
    assign compare = target.compare_at_price
    assign show_from = false
    assign has_selection = false
    if product.selected_variant != blank
      assign has_selection = true
    endif
    if product.price_varies and has_selection == false
      assign price = product.price_min
      assign compare = product.compare_at_price_max
      assign show_from = true
    endif
  endif

  assign on_sale = false
  if compare and compare > price
    assign on_sale = true
  endif
-%}

<div class="price {% if on_sale %}price--on-sale{% endif %} {{ class }}">
  {%- if show_from -%}
    <span class="price__from">{{ 'products.product.from_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    {{ price | money }}
  </span>
  {%- if on_sale -%}
    <s class="price__compare">
      <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
      {{ compare | money }}
    </s>
    {%- if show_savings and settings.show_savings -%}
      {%- assign saved = compare | minus: price | money -%}
      <span class="price__save">
        {{- 'products.product.save_amount' | t: amount: saved -}}
      </span>
    {%- endif -%}
  {%- endif -%}
  {%- if variant.unit_price_measurement -%}
    <span class="price__unit">
      {{ variant.unit_price | money }} / {{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
