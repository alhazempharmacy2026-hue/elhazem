{%- comment -%}Accepts: paginate{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  {%- assign current_label = paginate.current_page | append: '' -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.page' | t: number: paginate.current_page }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" rel="prev">{{ 'general.pagination.previous' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == current_label -%}
        <span aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" rel="next">{{ 'general.pagination.next' | t }}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
