{%- comment -%}
  Renders a product card.
  Accepts: product (required), lazy (bool, default true), sizes (string)
{%- endcomment -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if variant.compare_at_price > variant.price
    assign on_sale = true
  endif
-%}

<div class="card">
  <div class="card__frame">
  <div class="card__badges">
    {%- if product.available == false -%}
      <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif on_sale and settings.show_sale_badge -%}
      {%- assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
      <span class="badge badge--sale">{{ 'products.product.on_sale' | t }} {{ pct }}%</span>
    {%- endif -%}
  </div>

  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      <img
        class="card__img--main"
        src="{{ product.featured_media | image_url: width: 600 }}"
        srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 900 }} 900w"
        sizes="{{ card_sizes }}"
        alt="{{ product.featured_media.alt | escape }}"
        width="600"
        height="600"
        loading="{{ loading }}"
      >
      {%- if settings.card_show_second_image and product.media[1] -%}
        <img
          class="card__img--alt"
          src="{{ product.media[1] | image_url: width: 600 }}"
          srcset="{{ product.media[1] | image_url: width: 300 }} 300w, {{ product.media[1] | image_url: width: 600 }} 600w"
          sizes="{{ card_sizes }}"
          alt=""
          width="600"
          height="600"
          loading="lazy"
        >
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>

  {%- if settings.card_quick_add and product.available -%}
    <div class="card__quick">
      {%- if product.variants.size == 1 -%}
        <button
          type="button"
          class="btn btn--sm btn--full"
          data-quick-add="{{ variant.id }}"
        >
          {{ 'products.product.quick_add' | t }}
        </button>
      {%- else -%}
        <a class="btn btn--sm btn--full btn--outline" href="{{ product.url }}">
          {{ 'products.product.choose_options' | t }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>

  <div class="card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <span class="card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    {%- render 'price', product: product, show_savings: false -%}
  </div>
</div>
