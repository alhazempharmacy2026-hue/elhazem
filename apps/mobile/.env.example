# اعمل نسخة من هذا الملف باسم .env في نفس المجلد وحط فيه بيانات مشروع Supabase الحقيقي.
# Expo بيفرض إن أي متغير بيئة تحب تستخدمه في كود العميل (client-side) يبدأ بـ EXPO_PUBLIC_
# (المتغيرات اللي بادئتها كده بس هي اللي بتتضمن في الحزمة النهائية للتطبيق).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
